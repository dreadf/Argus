# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed -- see scripts/security_preflight.py, which
# checks exactly that.

# Alpaca paper-trading account (data + execution).
ALPACA_API_KEY=your_alpaca_paper_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_here

# Gemini API key, used only by pipeline/reviewer/reviewer.py (the
# LLM Reviewer stage that can VETO or SHRINK a proposal, never approve
# one no guard already approved, and never increase its size).
GEMINI_API_KEY=your_gemini_key_here

# Streamlit dashboard: keep false for any public deploy. Write actions
# (approve/reject, limit sliders, stop) are gated behind this flag in
# pipeline/ui/app.py; a public Streamlit Cloud deploy should never set
# it to true.
CONTROLS_ENABLED=false
